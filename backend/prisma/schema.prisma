model Emission {
  id        Int    @id @default(autoincrement())
  entity    String // e.g., Country or Region
  year      Int
  co2       Float
  dataset   String // HF Dataset origin (e.g., Asia or Europe)
  
  @@unique([entity, year, dataset])
}

// LLM Agent Memory Persistence
model ChatSession {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id        Int         @id @default(autoincrement())
  sessionId String
  role      String      // 'user', 'assistant', 'system'
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id])
}